# Bright Data API 密钥 (https://brightdata.com/cp/setting/users)
BRIGHT_DATA_API_KEY=

# Bright Data 区域名称（在 Bright Data 控制面板中配置）
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_UNLOCKER_ZONE=

# OpenRouter API 密钥 (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 应用的基础服务路径（例如用于 demos.brightdata.com/open-enrich). 的 /open-enrich
# 本地开发时留空，以在 http://localhost:3000. 运行
# 必须在构建时设置：该值会内联到客户端 bundle 中。
NEXT_PUBLIC_BASE_PATH=
